{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteRegistrationTokens",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:eu-west-2:923927835297:table/aws-mp-registrations"
    },
    {
      "Sid": "LambdaBasicLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-2:923927835297:*"
    }
  ]
}
